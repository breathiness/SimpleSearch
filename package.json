{
  "name": "simple-search",
  "version": "2.12.0",
  "private": true,
  "type": "module",
  "description": "简单搜索 - 极简聚合搜索页，纯静态、零运行时依赖",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/breathiness/SimpleSearch.git"
  },
  "homepage": "https://breathiness.github.io/SimpleSearch/",
  "bugs": {
    "url": "https://github.com/breathiness/SimpleSearch/issues"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "validate": "node scripts/validate.mjs",
    "check": "npm run build && npm test && npm run validate",
    "e2e": "node scripts/e2e.mjs --shots",
    "check:sites": "node scripts/check-sites.mjs",
    "coverage": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=75 --test-coverage-functions=80 \"tests/**/*.test.mjs\"",
    "visual": "node scripts/visual.mjs",
    "visual:update": "node scripts/visual.mjs --update",
    "wiki:publish": "node scripts/publish-wiki.mjs",
    "serve": "node scripts/serve.mjs"
  }
}
